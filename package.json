{
  "name": "backline",
  "version": "0.1.0",
  "description": "PR previews for APIs and CLIs",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backline": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@octokit/rest": "^20.1.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
